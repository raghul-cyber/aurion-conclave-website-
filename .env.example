# ==============================================================================
# AURION CONCLAVE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development, or configure these variables
# in your cloud deployment platform (Vercel, AWS ECS, GCP Cloud Run, Railway).
# NEVER commit real production API keys or credentials to version control.
# ==============================================================================

# Core System
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000

# Server-Side Model Provider (Anthropic Claude 3.5 Sonnet / Haiku)
# Used by /api/agents/[slug]/run and /api/agents/[slug]/stream
# When omitted, the system operates in Deterministic Sandbox Engine mode with
# full tool execution (math calculators, security scanners, AST parsers).
ANTHROPIC_API_KEY=

# Optional Alternative Provider (OpenAI GPT-4o)
OPENAI_API_KEY=

# Live Search & Retrieval Tools (Used by Research Agent #02)
# When provided, Research Agent queries live web results; otherwise uses
# grounded verified internal technological benchmarks.
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Enterprise CRM & Lead Intake (Used by /api/contact)
# Optional webhook URL for dispatching project intake briefs
CONTACT_WEBHOOK_URL=
SLACK_ALERT_WEBHOOK=

# Database / Persistent Session Storage (Optional)
# DATABASE_URL=postgresql://aurion_user:password@localhost:5432/aurion_db

# Security & Rate Limiting
# Max requests per IP per minute for public agent execution endpoints
AGENT_RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=15000
